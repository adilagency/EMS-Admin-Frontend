PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ems_admin
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_SECRET=ems_admin_secret_change_me
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMDS Integration (field first-order attendance)
SMDS_BASE_URL=https://sds.adilagencies.net/api/integration/v1
SMDS_LOGIN_ID=adil.payroll
SMDS_SECRET=isk__your_secret_here
# Optional: delay between SMDS calls (ms), sync interval (ms)
# SMDS_SYNC_DELAY_MS=900
# SMDS_SYNC_INTERVAL_MS=3600000

# Production (Railway) examples:
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ems_admin?retryWrites=true&w=majority
# CLIENT_URL=https://adilagenciesems.netlify.app
# JWT_SECRET=<long random string>
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
